{
  "title": "Auth API",
  "version": "1.0.0",
  "baseUrl": "http://localhost:3000",
  "authHeaders": {
    "description": "Required on protected endpoints. Geolocation must be within the configured allowed area unless the user is a Super Admin or Admin. Accepts x-geo-ltd/x-geo-lgt or x-geo-lat/x-geo-lng.",
    "headers": {
      "Authorization": "Bearer <jwt>",
      "x-geo-ltd": "number",
      "x-geo-lgt": "number"
    }
  },
  "endpoints": [
    {
      "name": "Register",
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user and return a JWT. Requires geolocation for auditing and geofence validation.",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "username": "string",
          "email": "string",
          "password": "string",
          "ltd": "number (or use lat)",
          "lgt": "number (or use lng)"
        },
        "examples": [
          {
            "username": "alice",
            "email": "alice@example.com",
            "password": "S3cur3Pass!",
            "ltd": 40.7128,
            "lgt": -74.006
          }
        ]
      },
      "responses": {
        "201": {
          "description": "Created",
          "body": {
            "token": "jwt-string",
            "user": {
              "id": "uuid",
              "username": "string",
            "email": "string",
            "role": "USER | ADMIN | SUPER_ADMIN"
            }
          }
        },
        "400": {
          "description": "Missing required fields",
          "body": {
            "error": "Username, email, and password are required"
          }
        },
        "400_geo": {
          "description": "Missing geolocation",
          "body": {
            "error": "Geolocation (ltd, lgt) is required"
          }
        },
        "409": {
          "description": "Email or username already in use",
          "body": {
            "error": "Email already in use"
          }
        },
        "500": {
          "description": "Server error",
          "body": {
            "error": "string"
          }
        }
      }
    },
    {
      "name": "Login",
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT. Geolocation must be within the configured allowed area unless the user is a Super Admin or Admin.",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "string",
          "password": "string",
          "ltd": "number (or use lat)",
          "lgt": "number (or use lng)"
        },
        "examples": [
          {
            "email": "alice@example.com",
            "password": "S3cur3Pass!",
            "ltd": 40.7128,
            "lgt": -74.006
          }
        ]
      },
      "responses": {
        "200": {
          "description": "OK",
          "body": {
            "token": "jwt-string",
            "user": {
              "id": "uuid",
              "username": "string",
            "email": "string",
            "role": "USER | ADMIN | SUPER_ADMIN"
            }
          }
        },
        "400": {
          "description": "Missing required fields",
          "body": {
            "error": "Email and password are required"
          }
        },
        "400_geo": {
          "description": "Missing geolocation",
          "body": {
            "error": "Geolocation (ltd, lgt) is required"
          }
        },
        "403": {
          "description": "Geolocation not allowed (outside allowed area)",
          "body": {
            "error": "Geolocation outside allowed area"
          }
        },
        "401": {
          "description": "Invalid credentials",
          "body": {
            "error": "Invalid credentials"
          }
        },
        "500": {
          "description": "Server error",
          "body": {
            "error": "string"
          }
        }
      }
    },
    {
      "name": "Get Allowed Area",
      "method": "GET",
      "path": "/geofence",
      "description": "Get the current allowed area (protected; requires auth headers).",
      "responses": {
        "200": {
          "description": "OK",
          "body": {
            "area": {
              "ltd": "number",
              "lgt": "number",
              "radiusMeters": "number"
            }
          }
        },
        "404": {
          "description": "Not configured",
          "body": {
            "error": "Allowed area not configured"
          }
        }
      }
    },
    {
      "name": "Set Allowed Area",
      "method": "PUT",
      "path": "/admin/geofence",
      "description": "Create or update the allowed area (Super Admin only).",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "ltd": "number (or use lat)",
          "lgt": "number (or use lng)",
          "radiusMeters": "number"
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "body": {
            "area": {
              "ltd": "number",
              "lgt": "number",
              "radiusMeters": "number"
            }
          }
        },
        "403": {
          "description": "Super Admin required",
          "body": {
            "error": "Super Admin access required"
          }
        }
      }
    },
    {
      "name": "Set User Role",
      "method": "PATCH",
      "path": "/admin/users/:id/role",
      "description": "Update a user's role (Super Admin only).",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "role": "USER | ADMIN | SUPER_ADMIN"
        }
      }
    },
    {
      "name": "Update Geolocation",
      "method": "PATCH",
      "path": "/me/geolocation",
      "description": "Update the user's stored geolocation (protected; requires auth headers).",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "ltd": "number (or use lat)",
          "lgt": "number (or use lng)"
        },
        "examples": [
          {
            "ltd": 40.7128,
            "lgt": -74.006
          }
        ]
      },
      "responses": {
        "200": {
          "description": "OK",
          "body": {
            "geolocation": {
              "ltd": "number",
              "lgt": "number"
            }
          }
        },
        "400": {
          "description": "Missing geolocation",
          "body": {
            "error": "Geolocation (ltd, lgt) is required"
          }
        },
        "401": {
          "description": "Unauthorized",
          "body": {
            "error": "Invalid or expired token"
          }
        },
        "403": {
          "description": "Geolocation not allowed",
          "body": {
            "error": "Geolocation not allowed for user"
          }
        },
        "500": {
          "description": "Server error",
          "body": {
            "error": "string"
          }
        }
      }
    }
  ]
}
